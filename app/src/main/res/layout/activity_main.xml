<?xml version="1.0" encoding="utf-8"?>



<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:gravity="center"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@color/freeze_white">

    <Spinner
        android:id="@+id/location_spinner"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:background="@drawable/specialedittext"
        android:layout_marginBottom="50dp"
         />

    <EditText
        android:id="@+id/input_range"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:layout_marginBottom="30dp"
        android:background="@drawable/specialedittext"
        android:hint="Enter range (km)"
        tools:inputType="number" />

    <Button
        android:id="@+id/find_button"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:background="@drawable/button_layout"
        android:backgroundTint="@null"
        android:gravity="center"
        android:minWidth="150dp"
        android:text="Detect strikes"
        android:textAllCaps="false"
        android:textColor="@color/freeze_white"
        android:textSize="16sp" />

</LinearLayout>

